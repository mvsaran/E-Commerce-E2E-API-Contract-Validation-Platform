{
  "name": "ecommerce-playwright-postman",
  "version": "1.0.0",
  "description": "E-Commerce E2E + API Contract Validation Platform — Playwright + Postman + AJV + Allure",
  "private": true,
  "scripts": {
    "start": "ts-node backend/server.ts",
    "build:backend": "tsc --project tsconfig.backend.json",
    "start:prod": "node dist/backend/server.js",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-results",
    "postman:run": "newman run postman/collections/Ecommerce.collection.json --environment postman/environments/Local.environment.json --reporters cli,json --reporter-json-export test-results/newman-results.json",
    "postman:test": "postman application test",
    "lint": "tsc --noEmit",
    "clean": "rimraf allure-results allure-report test-results playwright-report"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.44.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/uuid": "^9.0.8",
    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1",
    "allure-playwright": "^3.9.0",
    "newman": "^6.1.3",
    "postman-playwright": "^1.1.1",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
