# Environment Configuration
# Copy this file to .env and fill in your values

# Application base URL
BASE_URL=http://localhost:3000

# Backend server port
PORT=3000

# Test credentials (matches backend/data/users.json)
TEST_EMAIL=admin@test.com
TEST_PASSWORD=password123

# JWT secret for token signing (backend)
JWT_SECRET=ecommerce-super-secret-jwt-key-2024

# Postman API Key (required for: postman application test)
# Get from: https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=your-postman-api-key-here

# Postman Collection ID (optional — for cloud sync)
POSTMAN_COLLECTION_ID=

# Node environment
NODE_ENV=development
